# Токен від @BotFather
BOT_TOKEN=
# Часова зона за замовчуванням для нових користувачів
DEFAULT_TZ=Europe/Kyiv
# (необов'язково) ID користувачів через кому, яким дозволено користуватись ботом. Порожньо = усім.
ALLOWED_USERS=

# --- Vercel / serverless ---
# База Turso (turso.tech): libsql://назва-орг.turso.io та токен доступу
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Випадкові рядки (латиниця, цифри, _ і -): секрет вебхука Telegram і секрет пінгера /api/tick
WEBHOOK_SECRET=
CRON_SECRET=

# --- Локальний запуск (polling), якщо Turso не задано ---
DB_PATH=data/tracker.db

# --- Чат із ШІ (необов'язково): ключ від Google AI Studio ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
CHAT_DAILY_LIMIT=30
