# Токен від @BotFather
BOT_TOKEN=
# Часова зона за замовчуванням для нових користувачів
DEFAULT_TZ=Europe/Kyiv
# Файл бази даних
DB_PATH=data/tracker.db
# (необов'язково) ID користувачів через кому, яким дозволено користуватись ботом. Порожньо = усім.
ALLOWED_USERS=
# (необов'язково) Чат із ШІ: ключ від Google AI Studio (безкоштовний тариф)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Максимум повідомлень чату на добу
CHAT_DAILY_LIMIT=30
